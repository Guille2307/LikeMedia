# es preferible; ADMIN_PASSWORD se mantiene como alternativa de migración.
JWT_SECRET=
ADMIN_EMAIL=info@likemedia.es
ADMIN_NAME=Dysmar Vidal
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
